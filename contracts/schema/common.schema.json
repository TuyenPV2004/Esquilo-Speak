{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.esquilospeak.com/content/common.schema.json",
  "title": "EsquiloSpeak content common definitions",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 100
    },
    "locale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
      "examples": ["vi", "en", "pt-BR"]
    },
    "localizedText": {
      "type": "object",
      "description": "Text indexed by BCP 47 language tag.",
      "minProperties": 1,
      "patternProperties": {
        "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "proficiencyReference": {
      "type": "object",
      "description": "A level in a versioned proficiency framework. Framework and level codes are data, not application enums.",
      "required": ["frameworkCode", "frameworkVersion", "levelCode"],
      "properties": {
        "frameworkCode": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,49}$"
        },
        "frameworkVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "levelCode": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,49}$"
        }
      },
      "additionalProperties": false
    },
    "courseProficiency": {
      "type": "object",
      "description": "The entry and target levels for one course version in one versioned framework.",
      "required": [
        "frameworkCode",
        "frameworkVersion",
        "entryLevelCode",
        "targetLevelCode"
      ],
      "properties": {
        "frameworkCode": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,49}$"
        },
        "frameworkVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "entryLevelCode": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,49}$"
        },
        "targetLevelCode": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,49}$"
        }
      },
      "additionalProperties": false
    },
    "difficulty": {
      "type": "string",
      "enum": ["introductory", "guided", "independent", "checkpoint"]
    },
    "skill": {
      "type": "string",
      "enum": ["reading", "listening", "writing", "speaking", "vocabulary", "grammar"]
    },
    "outcomeDefinition": {
      "type": "object",
      "required": ["id", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "description": { "$ref": "#/$defs/localizedText" }
      },
      "additionalProperties": false
    },
    "conceptDefinition": {
      "type": "object",
      "required": ["id", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "description": { "$ref": "#/$defs/localizedText" },
        "prerequisiteConceptIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "accessibilityMetadata": {
      "type": "object",
      "required": ["screenReaderLabel", "requiresAudio", "supportsSilentMode"],
      "properties": {
        "screenReaderLabel": { "$ref": "#/$defs/localizedText" },
        "requiresAudio": { "type": "boolean" },
        "supportsSilentMode": { "type": "boolean" },
        "interactionHint": { "$ref": "#/$defs/localizedText" }
      },
      "additionalProperties": false
    },
    "contentStatus": {
      "type": "string",
      "enum": ["draft", "review", "approved", "scheduled", "published", "retired"]
    },
    "contentMetadata": {
      "type": "object",
      "required": ["version", "status", "owner", "license"],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "$ref": "#/$defs/contentStatus"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "source": {
          "type": "string",
          "format": "uri"
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "mediaMetadata": {
      "type": "object",
      "description": "Reference metadata only. Binary media belongs in an object store when production media is introduced.",
      "required": ["id", "type", "objectKey", "checksum", "locale"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "type": "string", "enum": ["audio", "image"] },
        "objectKey": { "type": "string", "minLength": 1, "maxLength": 500 },
        "checksum": { "type": "string", "minLength": 8, "maxLength": 200 },
        "locale": { "$ref": "#/$defs/locale" },
        "durationMs": { "type": "integer", "minimum": 0 },
        "altText": { "$ref": "#/$defs/localizedText" }
      },
      "additionalProperties": false
    }
  }
}
