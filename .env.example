# Local PostgreSQL only. Copy to .env and choose a local-only password.
POSTGRES_DB=esquilospeak
POSTGRES_USER=esquilospeak
POSTGRES_PASSWORD=replace-with-a-local-password

# Backend runtime
ESQUILO_DB_URL=jdbc:postgresql://localhost:5432/esquilospeak
ESQUILO_DB_USERNAME=esquilospeak
ESQUILO_DB_PASSWORD=replace-with-the-same-local-password

# Production only. The local profile generates an ephemeral guest JWT.
ESQUILO_JWT_ISSUER_URI=https://identity.example.com
ESQUILO_JWT_AUDIENCE=esquilospeak-mobile
